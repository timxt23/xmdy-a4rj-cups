#!/bin/sh
# Package postinstall. Never fails the installation: queues can be added
# later with setup-queue.sh or in System Settings > Printers & Scanners.
# setup-queue.sh --bluetooth also loads the Bluetooth bridge agent and
# removes the system daemon used by 1.1.0 development builds.
/Library/Printers/XMDY-A4/setup-queue.sh || true
/Library/Printers/XMDY-A4/setup-queue.sh --bluetooth || true
exit 0
