<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>XMDY A4RJ Printer Driver</title>
    <welcome file="welcome.html" mime-type="text/html"/>
    <license file="LICENSE.txt" mime-type="text/plain"/>
    <options customize="never" require-scripts="false" rootVolumeOnly="true" hostArchitectures="arm64,x86_64"/>
    <domains enable_anywhere="false" enable_currentUserHome="false" enable_localSystem="true"/>
    <volume-check>
        <allowed-os-versions>
            <os-version min="11.0"/>
        </allowed-os-versions>
    </volume-check>
    <choices-outline>
        <line choice="default"/>
    </choices-outline>
    <choice id="default" title="XMDY A4RJ Printer Driver">
        <pkg-ref id="io.github.timxt23.xmdy-a4rj"/>
    </choice>
    <pkg-ref id="io.github.timxt23.xmdy-a4rj" version="@VERSION@" onConclusion="none">xmdy-a4rj-core.pkg</pkg-ref>
</installer-gui-script>
